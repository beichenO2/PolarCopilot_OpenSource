{
  "name": "polarcop-hub",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pc": "./dist/pc-cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ssot:audit": "node scripts/ssot-audit.mjs",
    "ssot:audit:strict": "node scripts/ssot-audit.mjs --strict",
    "sync-skills": "bash ../scripts/sync-skills.sh",
    "verify-skills": "bash ../scripts/sync-skills.sh --verify",
    "sync-handoff": "bash scripts/sync-handoff-rule.sh",
    "verify-handoff": "bash scripts/sync-handoff-rule.sh --verify",
    "rr:mcp": "tsx src/rr/stdio-server.ts",
    "rr:mcp:built": "node dist/rr/stdio-server.js",
    "rr:install": "node ../scripts/install-rr-mcp.mjs",
    "rr:verify": "node ../scripts/install-rr-mcp.mjs --verify",
    "rr:orchestrator": "tsx src/rr/orchestrator-cli.ts",
    "rr:orchestrator:init": "tsx src/rr/orchestrator-cli.ts init",
    "rr:orchestrator:start": "tsx src/rr/orchestrator-cli.ts start",
    "rr:orchestrator:stop": "tsx src/rr/orchestrator-cli.ts halt",
    "rr:orchestrator:status": "tsx src/rr/orchestrator-cli.ts status",
    "rr:xj:dry-run": "tsx src/rr/xj-migration-cli.ts --dry-run",
    "rr:xj:import": "tsx src/rr/xj-migration-cli.ts --import",
    "rr:xj:verify": "tsx src/rr/xj-migration-cli.ts --verify",
    "rr:xj:cleanup:scan": "tsx src/rr/xj-cleanup-cli.ts --scan",
    "rr:xj:cleanup:gate": "tsx src/rr/xj-cleanup-cli.ts --create-gate",
    "rr:xj:cleanup:apply": "tsx src/rr/xj-cleanup-cli.ts --apply",
    "pc": "tsx src/pc-cli.ts",
    "smoke:afk-modes": "bash ../scripts/smoke-afk-modes.sh",
    "smoke:afk-short-run": "bash ../scripts/smoke-afk-short-run.sh"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/multer": "^2.1.0",
    "better-sqlite3": "12.8.0",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "nanoid": "5.1.7",
    "pino": "10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "4.21.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.2"
  }
}
